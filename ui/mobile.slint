// ui/mobile.slint
// Neknaj Typing MP - mobile / touch backend UI.
//
// The screen keyboard layout is supplied by Rust from src/screen_keyboard.rs.
// Slint renders key rows and reports pointer deltas; it does not own keyboard
// layout, flick resolution, post modifiers, or layout switching.

export enum KeyboardVisualKind {
    Text,
    Special,
    Backspace,
    Enter,
    Modifier,
    Spacer,
}

export enum KeyboardWidthKind {
    Normal,
    Wide,
    Space,
}

export struct KeyboardKeyView {
    label: string,
    up: string,
    right: string,
    down: string,
    left: string,
    visual-kind: KeyboardVisualKind,
    width-kind: KeyboardWidthKind,
    interactive: bool,
}

component ScreenKey {
    in property <KeyboardKeyView> key;
    in property <int> row-index;
    in property <int> key-index;

    callback key-gesture(int, int, float, float);

    private property <float> start-x-px;
    private property <float> start-y-px;
    private property <bool> is-spacer: root.key.visual-kind == KeyboardVisualKind.Spacer;
    private property <bool> is-special:
        root.key.visual-kind == KeyboardVisualKind.Special
        || root.key.visual-kind == KeyboardVisualKind.Modifier;
    private property <bool> is-backspace: root.key.visual-kind == KeyboardVisualKind.Backspace;
    private property <bool> is-enter: root.key.visual-kind == KeyboardVisualKind.Enter;

    horizontal-stretch:
        root.key.width-kind == KeyboardWidthKind.Space ? 5 :
        root.key.width-kind == KeyboardWidthKind.Wide ? 2 : 1;
    height: 65px;

    Rectangle {
        background:
            root.is-spacer ? #181828 :
            ta.pressed ? #4a4a5a :
            root.is-enter ? #1e304a :
            root.is-backspace ? #2a1a1a :
            root.is-special ? #1e1e2c :
            #2e2e3e;
        border-color:
            root.is-spacer ? #181828 :
            root.is-enter ? #2255aa :
            root.is-backspace ? #553355 :
            root.is-special ? #333344 :
            #444466;
        border-width: root.is-spacer ? 0px : 1px;
        border-radius: 6px;

        Text {
            text: root.key.label;
            color:
                root.is-enter ? #aac4ff :
                root.is-backspace ? #cc99cc :
                root.is-special ? #cccccc :
                #ffffff;
            font-size:
                root.is-special ? 15px :
                root.key.width-kind == KeyboardWidthKind.Space ? 17px :
                22px;
            font-weight: root.key.visual-kind == KeyboardVisualKind.Text ? 700 : 500;
            vertical-alignment: TextVerticalAlignment.center;
            horizontal-alignment: TextHorizontalAlignment.center;
            width: parent.width;
            height: parent.height;
        }

        if root.key.up != "": Text {
            text: root.key.up;
            color: #8888bb;
            font-size: 11px;
            x: (parent.width - self.width) / 2;
            y: 4px;
        }
        if root.key.down != "": Text {
            text: root.key.down;
            color: #8888bb;
            font-size: 11px;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 4px;
        }
        if root.key.left != "": Text {
            text: root.key.left;
            color: #8888bb;
            font-size: 11px;
            x: 4px;
            y: (parent.height - self.height) / 2;
        }
        if root.key.right != "": Text {
            text: root.key.right;
            color: #8888bb;
            font-size: 11px;
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        pointer-event(ev) => {
            if root.key.interactive {
                if ev.kind == PointerEventKind.down {
                    root.start-x-px = ta.mouse-x / 1px;
                    root.start-y-px = ta.mouse-y / 1px;
                } else if ev.kind == PointerEventKind.up {
                    root.key-gesture(
                        root.row-index,
                        root.key-index,
                        ta.mouse-x / 1px - root.start-x-px,
                        ta.mouse-y / 1px - root.start-y-px,
                    );
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Neknaj Typing MP";
    min-width: 320px;
    min-height: 480px;
    background: #000000;

    in property <image> frame;
    in property <bool> keyboard-visible;
    in property <[KeyboardKeyView]> keyboard-row-0;
    in property <[KeyboardKeyView]> keyboard-row-1;
    in property <[KeyboardKeyView]> keyboard-row-2;
    in property <[KeyboardKeyView]> keyboard-row-3;

    out property <float> keyboard-logical-height:
        keyboard-visible ? (keyboard-collapsed ? 32.0 : 320.0) : 0.0;

    private property <bool> keyboard-collapsed: false;
    private property <bool> in-adjust-mode: false;

    callback char-input(string);
    callback special-input(string);
    callback screen-keyboard-gesture(int, int, float, float);

    init => { fs.focus(); }

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Return {
                root.special-input("Enter");
            } else if event.text == Key.Escape {
                root.special-input("Escape");
            } else if event.text == Key.Backspace {
                root.special-input("Backspace");
            } else if event.text == Key.UpArrow {
                root.special-input("Up");
            } else if event.text == Key.DownArrow {
                root.special-input("Down");
            } else if event.text != "" {
                root.char-input(event.text);
            }
            EventResult.accept
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                vertical-stretch: 1;
                clip: true;
                background: #000000;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: ImageFit.fill;
                    image-rendering: ImageRendering.pixelated;
                }
            }

            if keyboard-visible: VerticalLayout {
                spacing: 0px;
                padding: 0px;

                if !keyboard-collapsed: Rectangle {
                    background: #181828;
                    height: 288px;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            for key[index] in root.keyboard-row-0: ScreenKey {
                                key: key;
                                row-index: 0;
                                key-index: index;
                                key-gesture(row, key, dx, dy) => {
                                    root.screen-keyboard-gesture(row, key, dx, dy);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            for key[index] in root.keyboard-row-1: ScreenKey {
                                key: key;
                                row-index: 1;
                                key-index: index;
                                key-gesture(row, key, dx, dy) => {
                                    root.screen-keyboard-gesture(row, key, dx, dy);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            for key[index] in root.keyboard-row-2: ScreenKey {
                                key: key;
                                row-index: 2;
                                key-index: index;
                                key-gesture(row, key, dx, dy) => {
                                    root.screen-keyboard-gesture(row, key, dx, dy);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            for key[index] in root.keyboard-row-3: ScreenKey {
                                key: key;
                                row-index: 3;
                                key-index: index;
                                key-gesture(row, key, dx, dy) => {
                                    root.screen-keyboard-gesture(row, key, dx, dy);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: #0c0c1a;

                    if in-adjust-mode: Rectangle {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: 120px;
                        height: 22px;
                        background: collapse-ta.pressed ? #334 : #1e1e30;
                        border-color: #445;
                        border-width: 1px;
                        border-radius: 4px;
                        Text {
                            text: root.keyboard-collapsed ? "▲ 表示" : "▼ 非表示";
                            color: #99aadd;
                            font-size: 12px;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            width: parent.width;
                            height: parent.height;
                        }
                        collapse-ta := TouchArea {
                            clicked => { root.keyboard-collapsed = !root.keyboard-collapsed; }
                        }
                    }

                    Rectangle {
                        x: parent.width - self.width - 8px;
                        y: (parent.height - self.height) / 2;
                        width: 52px;
                        height: 22px;
                        background: mode-ta.pressed ? #445 : #1e1e30;
                        border-color: root.in-adjust-mode ? #6677cc : #334;
                        border-width: 1px;
                        border-radius: 4px;
                        Text {
                            text: root.in-adjust-mode ? "入力" : "⚙";
                            color: root.in-adjust-mode ? #aabbff : #667;
                            font-size: 13px;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            width: parent.width;
                            height: parent.height;
                        }
                        mode-ta := TouchArea {
                            clicked => { root.in-adjust-mode = !root.in-adjust-mode; }
                        }
                    }
                }
            }
        }
    }
}
