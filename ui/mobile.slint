// ui/mobile.slint
// Neknaj Typing MP — モバイル(Slint)バックエンド UI
//
// キーボードエリア構成:
//   制御ストリップ (32px, keyboard-visible 時に常時表示)
//     └── 右端: ⚙ / 入力 ボタン → 調整モードをトグル
//     └── 左側: ▲/▼ ボタン → 調整モード時のみ表示（キーボード折畳み）
//   キー行エリア (288px, !keyboard-collapsed 時のみ)
//
// 制御ストリップ合計高さ:
//   keyboard-visible && !keyboard-collapsed → 32 + 288 = 320 (論理px)
//   keyboard-visible &&  keyboard-collapsed → 32
//   !keyboard-visible                       → 0
//
// この値は out property keyboard-logical-height で Rust に公開され、
// canvas の物理ピクセルサイズ計算に使用される。
//
// フリック方向の規則:
//   上フリック → u段 (う行)
//   左フリック → i段 (い行)
//   右フリック → e段 (え行)
//   下フリック → o段 (お行)

// フリックキー一つ分のコンポーネント。
component FlickKey {
    in property <string> center;
    in property <string> flick-up: "";
    in property <string> flick-right: "";
    in property <string> flick-down: "";
    in property <string> flick-left: "";

    callback tapped(string);

    private property <float> start-x-px;
    private property <float> start-y-px;
    private property <float> dx;
    private property <float> dy;

    height: 65px;

    Rectangle {
        background: ta.pressed ? #4a4a5a : #2e2e3e;
        border-color: #444466;
        border-width: 1px;
        border-radius: 6px;

        // 中央文字
        VerticalLayout {
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                alignment: LayoutAlignment.center;
                Text { text: root.center; color: #ffffff; font-size: 24px; }
            }
        }

        // フリック方向ヒント: 上=u段, 下=o段, 左=i段, 右=e段
        if root.flick-up != "": Text {
            text: root.flick-up; color: #8888bb; font-size: 11px;
            x: (parent.width - self.width) / 2; y: 4px;
        }
        if root.flick-down != "": Text {
            text: root.flick-down; color: #8888bb; font-size: 11px;
            x: (parent.width - self.width) / 2; y: parent.height - self.height - 4px;
        }
        if root.flick-left != "": Text {
            text: root.flick-left; color: #8888bb; font-size: 11px;
            x: 4px; y: (parent.height - self.height) / 2;
        }
        if root.flick-right != "": Text {
            text: root.flick-right; color: #8888bb; font-size: 11px;
            x: parent.width - self.width - 4px; y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.start-x-px = ta.mouse-x / 1px;
                root.start-y-px = ta.mouse-y / 1px;
            } else if ev.kind == PointerEventKind.up {
                root.dx = ta.mouse-x / 1px - root.start-x-px;
                root.dy = ta.mouse-y / 1px - root.start-y-px;
                if root.dx > -20 && root.dx < 20 && root.dy > -20 && root.dy < 20 {
                    // タップ: 移動量が閾値以内
                    if root.center != "" { root.tapped(root.center); }
                } else if root.dy * root.dy > root.dx * root.dx {
                    // 縦フリック優勢 (dy² > dx²)
                    if root.dy < 0 {
                        if root.flick-up != "" { root.tapped(root.flick-up); }
                    } else {
                        if root.flick-down != "" { root.tapped(root.flick-down); }
                    }
                } else {
                    // 横フリック優勢
                    if root.dx < 0 {
                        if root.flick-left != "" { root.tapped(root.flick-left); }
                    } else {
                        if root.flick-right != "" { root.tapped(root.flick-right); }
                    }
                }
            }
        }
    }
}

// 特殊操作キー (BS / Enter など)
component SpecialKey {
    in property <string> label;
    in property <string> action;
    in property <color> bg: #252535;

    callback do-special(string);

    height: 65px;

    Rectangle {
        background: ta.pressed ? #6a3a4a : root.bg;
        border-color: #554455;
        border-width: 1px;
        border-radius: 6px;
        VerticalLayout {
            alignment: LayoutAlignment.center;
            HorizontalLayout {
                alignment: LayoutAlignment.center;
                Text { text: root.label; color: #cccccc; font-size: 18px; }
            }
        }
    }
    ta := TouchArea {
        clicked => { root.do-special(root.action); }
    }
}

// アプリのメインウィンドウ
export component AppWindow inherits Window {
    title: "Neknaj Typing MP";
    min-width: 320px;
    min-height: 480px;
    background: #000000;

    // Rust → Slint: フレームバッファ画像・キーボード表示指示
    in property <image> frame;
    in property <bool> keyboard-visible;

    // Slint → Rust: 制御ストリップ込みのキーボードエリア論理高さ (px 単位の float)
    // Rust はこの値を使って canvas の物理ピクセルサイズを算出する
    out property <float> keyboard-logical-height:
        keyboard-visible ? (keyboard-collapsed ? 32.0 : 320.0) : 0.0;

    // キーボード折畳み状態 (ユーザー操作で変化, 内部状態)
    private property <bool> keyboard-collapsed: false;
    // 調整モード (true = 折畳み制御ボタンを表示)
    private property <bool> in-adjust-mode: false;

    callback char-input(string);
    callback special-input(string);

    init => { fs.focus(); }

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Return {
                root.special-input("Enter");
            } else if event.text == Key.Escape {
                root.special-input("Escape");
            } else if event.text == Key.Backspace {
                root.special-input("Backspace");
            } else if event.text == Key.UpArrow {
                root.special-input("Up");
            } else if event.text == Key.DownArrow {
                root.special-input("Down");
            } else if event.text != "" {
                root.char-input(event.text);
            }
            EventResult.accept
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ゲーム描画エリア
            // Rust が物理ピクセルサイズのバッファを生成し ImageFit.fill で論理サイズにフィット。
            // 描画サイズと論理サイズのアスペクト比は等しい (両者とも scale で変換されるため)
            // → fill しても歪みは発生しない。
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                background: #000000;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: ImageFit.fill;
                    image-rendering: ImageRendering.pixelated;
                }
            }

            // キーボードエリア (keyboard-visible 時のみ)
            if keyboard-visible: VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // キー行エリア: 折畳み時は非表示 (288px)
                if !keyboard-collapsed: Rectangle {
                    background: #181828;
                    height: 288px;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        // Row 1: あ か さ  (上=u段, 左=i段, 右=e段, 下=o段)
                        HorizontalLayout {
                            spacing: 4px;
                            FlickKey { horizontal-stretch: 1; center: "あ"; flick-up: "う"; flick-left: "い"; flick-right: "え"; flick-down: "お"; tapped(c) => { root.char-input(c); } }
                            FlickKey { horizontal-stretch: 1; center: "か"; flick-up: "く"; flick-left: "き"; flick-right: "け"; flick-down: "こ"; tapped(c) => { root.char-input(c); } }
                            FlickKey { horizontal-stretch: 1; center: "さ"; flick-up: "す"; flick-left: "し"; flick-right: "せ"; flick-down: "そ"; tapped(c) => { root.char-input(c); } }
                        }

                        // Row 2: た な は
                        HorizontalLayout {
                            spacing: 4px;
                            FlickKey { horizontal-stretch: 1; center: "た"; flick-up: "つ"; flick-left: "ち"; flick-right: "て"; flick-down: "と"; tapped(c) => { root.char-input(c); } }
                            FlickKey { horizontal-stretch: 1; center: "な"; flick-up: "ぬ"; flick-left: "に"; flick-right: "ね"; flick-down: "の"; tapped(c) => { root.char-input(c); } }
                            FlickKey { horizontal-stretch: 1; center: "は"; flick-up: "ふ"; flick-left: "ひ"; flick-right: "へ"; flick-down: "ほ"; tapped(c) => { root.char-input(c); } }
                        }

                        // Row 3: ま や ら
                        HorizontalLayout {
                            spacing: 4px;
                            FlickKey { horizontal-stretch: 1; center: "ま"; flick-up: "む"; flick-left: "み"; flick-right: "め"; flick-down: "も"; tapped(c) => { root.char-input(c); } }
                            // や行: ゆ(上/u), ゃ(左/小文字), ゅ(右/小文字), よ(下/o)
                            FlickKey { horizontal-stretch: 1; center: "や"; flick-up: "ゆ"; flick-left: "ゃ"; flick-right: "ゅ"; flick-down: "よ"; tapped(c) => { root.char-input(c); } }
                            FlickKey { horizontal-stretch: 1; center: "ら"; flick-up: "る"; flick-left: "り"; flick-right: "れ"; flick-down: "ろ"; tapped(c) => { root.char-input(c); } }
                        }

                        // Row 4: BS | わ | 。
                        HorizontalLayout {
                            spacing: 4px;
                            SpecialKey {
                                horizontal-stretch: 1;
                                label: "⌫";
                                action: "Backspace";
                                bg: #2a1a1a;
                                do-special(a) => { root.special-input(a); }
                            }
                            // わ行: を(左/o系), ん(下)
                            FlickKey {
                                horizontal-stretch: 1;
                                center: "わ";
                                flick-left: "を";
                                flick-down: "ん";
                                tapped(c) => { root.char-input(c); }
                            }
                            // 記号: 。center, ？上, ！右, …下, 、左
                            FlickKey {
                                horizontal-stretch: 1;
                                center: "。";
                                flick-up: "？";
                                flick-right: "！";
                                flick-down: "…";
                                flick-left: "、";
                                tapped(c) => { root.char-input(c); }
                            }
                        }
                    }
                }

                // 制御ストリップ (32px, 常時表示)
                // 右端: ⚙/入力 ボタンで調整モードをトグル
                // 左側: 調整モード時のみ ▲/▼ 折畳みボタンを表示
                Rectangle {
                    height: 32px;
                    background: #0c0c1a;

                    // 調整モード時: 折畳みトグルボタン (左寄せ)
                    if in-adjust-mode: Rectangle {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: 120px;
                        height: 22px;
                        background: collapse-ta.pressed ? #334 : #1e1e30;
                        border-color: #445;
                        border-width: 1px;
                        border-radius: 4px;
                        Text {
                            text: root.keyboard-collapsed ? "▲ 表示" : "▼ 非表示";
                            color: #99aadd;
                            font-size: 12px;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            width: parent.width;
                            height: parent.height;
                        }
                        collapse-ta := TouchArea {
                            clicked => { root.keyboard-collapsed = !root.keyboard-collapsed; }
                        }
                    }

                    // モード切替ボタン (右端固定)
                    Rectangle {
                        x: parent.width - self.width - 8px;
                        y: (parent.height - self.height) / 2;
                        width: 52px;
                        height: 22px;
                        background: mode-ta.pressed ? #445 : #1e1e30;
                        border-color: root.in-adjust-mode ? #6677cc : #334;
                        border-width: 1px;
                        border-radius: 4px;
                        Text {
                            text: root.in-adjust-mode ? "入力" : "⚙";
                            color: root.in-adjust-mode ? #aabbff : #667;
                            font-size: 13px;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            width: parent.width;
                            height: parent.height;
                        }
                        mode-ta := TouchArea {
                            clicked => { root.in-adjust-mode = !root.in-adjust-mode; }
                        }
                    }
                }
            }
        }
    }
}
